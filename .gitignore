# Secrets and machine-local settings: never commit
.env
.env.*
.claude/settings.local.json
CLAUDE.local.md
**/CLAUDE.local.md

# Pre-compact snapshots (transient, may contain raw prompt text)
.claude/state/

# Quarantined daily logs (failed generator output, kept locally for inspection)
daily-logs/.quarantine/

# Obsidian workspace state and plugin data (plugin data can hold API keys)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# OS and editor noise
.DS_Store
**/.DS_Store
.vscode/
.idea/
*.swp

# Raw data exports usually hold other people's personal data. Keep them local;
# commit the Markdown you derive from them instead.
*.csv
*.xlsx

# Marketing Brain: customer data in raw/voc/ stays on your machine. Only the
# README, the review URL list, and the fictional Acme Deals example are
# committed. These lines must stay below the *.csv rule above.
raw/voc/*
!raw/voc/README.md
!raw/voc/review-urls.md
!raw/voc/example/
!raw/voc/example/*.csv

# Marketing Brain: strategy docs and performance data stay local too.
raw/strategy/*
!raw/strategy/README.md
raw/performance/*
!raw/performance/README.md
